{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumeroVastu 360 Knowledge Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "packVersion",
    "db"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "packVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifestPath": {
      "type": "string"
    },
    "contribution": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "mode"
      ]
    },
    "db": {
      "type": "object",
      "required": [
        "chaldean",
        "friendship",
        "numbers",
        "watch",
        "vedicGrid",
        "traits",
        "missingFix",
        "yantra",
        "kua",
        "goals",
        "vastu",
        "careers",
        "dayWear",
        "personalYear",
        "spelling",
        "mantraShort",
        "zodiac",
        "crystals",
        "compound",
        "masterNumbers",
        "nameAdvice"
      ],
      "properties": {
        "vedicGrid": {
          "type": "object",
          "required": [
            "layout",
            "planes",
            "filtering"
          ],
          "properties": {
            "layout": {
              "const": [
                [
                  3,
                  1,
                  9
                ],
                [
                  6,
                  7,
                  5
                ],
                [
                  2,
                  8,
                  4
                ]
              ],
              "description": "Canonical Vedic Ank Kundali order: Practical/Fire, Materialistic/Air, Emotional/Water."
            },
            "planes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "description": "The Practical / Fire, Materialistic / Air and Emotional / Water horizontal planes.",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "name",
                  "element",
                  "cells",
                  "governs",
                  "roles"
                ]
              }
            },
            "filtering": {
              "type": "object",
              "required": [
                "zeros",
                "century",
                "dateDeduplication",
                "calculations"
              ],
              "properties": {
                "zeros": {
                  "type": "string"
                },
                "century": {
                  "type": "string"
                },
                "dateDeduplication": {
                  "type": "string"
                },
                "calculations": {
                  "type": "string"
                }
              }
            }
          }
        },
        "dosha": {
          "type": "object",
          "description": "Optional Ayurvedic dosha layer: numbers 1–9 map to a planetary constitutional signature (dominant, nature, aggravation, balancingFoods, routine, mantraLinkedNote)."
        },
        "deity": {
          "type": "object",
          "description": "Optional deity protection layer: numbers 1–9 map to an ishta devta (god, mantra, primaryChant, weeklyChant, offerings, support, protectionNote) — traditional spiritual guidance."
        },
        "dasha": {
          "type": "object",
          "description": "Optional numerology dasha layer: numbers 1-9 map to a period signature (theme, events, caution, zone, zoneElement, zoneRemedy — each localised en/hi/gu), plus lifeEvents definitions (icon, primary lords, support lords, age band, localised label) for the life-event window engine."
        }
      }
    }
  }
}

{
  "name": "numerovastu-360",
  "private": true,
  "version": "2.9.0",
  "description": "Hybrid Lo Shu Foundation & Ank Jyotish Dasha timeline — private numerology and Vastu guidance",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "npm run dev",
    "build": "node scripts/build-static.cjs",
    "atlas:build": "node scripts/build-atlas.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node smoke.test.js",
    "test:visual": "playwright test --update-snapshots=missing",
    "test:visual:ci": "playwright test --update-snapshots=none",
    "test:visual:update": "playwright test --update-snapshots=all",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run test && npm run audit && npm run build && npm run check:source-zip",
    "check:full": "npm run check && npm run test:visual:ci",
    "browsers:install": "playwright install chromium",
    "package:source": "node scripts/package-source.mjs",
    "check:source-zip": "node scripts/package-source.mjs --check",
    "icons:build": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2"
  }
}
